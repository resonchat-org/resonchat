{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ccproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:3000/v1",
        "apiKey": "{env:CC_PROXY_KEY}",
        "setCacheKey": true
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "cc-proxy deepseek-v4.1-flash"
        }
      }
    }
  }
}
