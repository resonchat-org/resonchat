# Local toolchain. The Flutter SDK lives inside the project on purpose: kept
# out of the home directory it reads as a leftover system package and gets
# deleted. Ignored by git; see README for the one-time install.
.tooling/

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
coverage/
.widget_preview/

# Codegen (drift / build_runner / flutter gen-l10n / freezed / mockito)
*.g.dart
*.freezed.dart
*.mocks.dart
**/generated/
**/l10n/generated/
app/android/app/src/main/res/mipmap-*/ic_launcher.png

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android (Flutter app/android.tmpl/.gitignore + local)
**/android/.gradle/
**/android/.kotlin/
**/android/captures/
**/android/local.properties
**/android/gradlew
**/android/gradlew.bat
**/android/gradle/wrapper/gradle-wrapper.jar
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/**/.cxx/
**/android/**/GeneratedPluginRegistrant.java
**/android/**/key.properties
**/android/**/*.keystore
**/android/**/*.jks
*.jks
*.keystore
**/key.properties

